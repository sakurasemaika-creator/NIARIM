<?xml version="1.0" encoding="utf-8" ?>
<!--
  意匠はアプリが焼いたPNG（shortcut_widget_renderer.dart）をfitCenterで
  出す方式。**正方形・横長・縦長の3通りを焼いてあり**、ネイティブ側
  （NiarimWidgetProviders.kt の imageKeyFor）が実際に置かれたマスの縦横比に
  近いものを選ぶ。横長のマスではアイコンと文字が横並びの意匠になる。
  既定の置かれ方は正方形（2x2マス）だが、横長にも縦長にもリサイズできる。

  minWidth 110dp は Android のマス目換算式（70*n-30）で2マス相当。
  minResize* を同値で明示して、文字が潰れる大きさまで縮められないようにする。
  （110dp で意匠内のラベルは実効10px前後。これ以上小さいと読めない。
  test/home_widget_cell_size_test.dart がこの下限で可読性を検証している）
-->
<appwidget-provider
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="110dp"
  android:minHeight="110dp"
  android:minResizeWidth="110dp"
  android:minResizeHeight="110dp"
  android:targetCellWidth="2"
  android:targetCellHeight="2"
  android:updatePeriodMillis="0"
  android:initialLayout="@layout/widget_shortcut"
  android:resizeMode="horizontal|vertical"
  android:previewLayout="@layout/widget_shortcut"
  android:description="@string/widget_create_picker"
  android:widgetCategory="home_screen"
/>
